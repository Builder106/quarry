{
  "name": "quarry-bot",
  "version": "0.0.1",
  "private": true,
  "description": "Off-chain mempool scanner for Quarry — pairs with the Yul executor in ../contracts",
  "type": "module",
  "scripts": {
    "scanner": "bun run src/scanner.ts",
    "demo": "bun run scripts/demo.ts",
    "replay": "bun run scripts/historical-replay.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "viem": "^2.55.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.2"
  }
}
